# Copy this file to .env and set it to your machine's LAN IP where the
# backend (docker-compose) is running — needed for testing on a physical
# device, since "localhost" on the phone means the phone itself.
# Requires an Expo dev-server restart after changing (env vars are inlined
# into the JS bundle at build time, not read at runtime).
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.50:8080

# Google Maps SDK for Android API key (from Google Cloud Console — Maps SDK
# for Android, restricted to this app's package name + signing SHA-1).
# Read by app.config.js at build/prebuild time — requires a new dev build
# (not just a reload) after changing. Needed for the map tab to render on
# Android; not needed for iOS (Apple Maps) or Expo Go (which can't use this
# at all — see the Android dev-build note wherever the map tab is documented).
GOOGLE_MAP_API=your-google-maps-android-api-key
