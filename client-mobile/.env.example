# Copy this file to .env and set it to your machine's LAN IP where the
# backend (docker-compose) is running — needed for testing on a physical
# device, since "localhost" on the phone means the phone itself.
# Requires an Expo dev-server restart after changing (env vars are inlined
# into the JS bundle at build time, not read at runtime).
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.50:8080
